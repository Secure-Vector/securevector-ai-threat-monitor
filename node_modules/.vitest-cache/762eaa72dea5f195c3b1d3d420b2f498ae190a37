  assert.match(src, /id="terminals-guard-banner-restart"[^>]*hidden/,
    'the button ships hidden in the template');

  for (const [governed, expected] of [[true, false], [false, true]]) {
    const els = bannerEls();
    const { Page } = loadPage(els);
    Page._tasks = [PENDING_TASK];
